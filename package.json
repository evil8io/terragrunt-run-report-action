{
  "name": "terragrunt-run-report-action",
  "version": "0.6.6",
  "private": true,
  "description": "GitHub action that reports the per-unit plan and apply results of terragrunt run --all",
  "license": "Apache-2.0",
  "repository": "github:evil8io/terragrunt-run-report-action",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "render": "node src/cli.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/glob": "0.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  },
  "type": "module"
}
