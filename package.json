{
  "name": "terragrunt-run-report-action",
  "version": "0.4.0",
  "private": true,
  "description": "GitHub action that reports the per-unit plan and apply results of terragrunt run --all",
  "license": "Apache-2.0",
  "repository": "github:evil8io/terragrunt-run-report-action",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "render": "node src/cli.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/glob": "0.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "type": "module"
}
